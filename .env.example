# Copy this file to .env and fill it in. Never share or commit .env.

# From @BotFather after /newbot
BOT_TOKEN=

# Your own Telegram user ID. Start the bot, send it /id, paste the number here.
ADMIN_ID=

# Your channel: @username for a public channel, or the -100... ID for a private one.
# The bot must be an administrator of the channel.
CHANNEL_ID=

# Only needed for a private channel: its invite link, used for "Join the channel" buttons.
CHANNEL_URL=

# The public https address of the site once it is deployed. Leave empty while testing locally.
PUBLIC_URL=

# When the channel posts, 24-hour times separated by commas. Empty turns scheduled posts off.
POST_TIMES=10:00,19:00

# Timezone for POST_TIMES, for example Asia/Singapore. Defaults to this computer's timezone.
TIMEZONE=

PORT=3000
